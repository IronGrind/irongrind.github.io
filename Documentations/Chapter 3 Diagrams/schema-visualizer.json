    {
      "Name": "private.admin_login_approvals",
      "Purpose": "Records session-bound administrator login requests and approval decisions. Approval alone does not authorize the requesting browser; current device proof and fresh TOTP are also required for replacement.",
      "Columns": [
        {
          "Name": "id",
          "Type": "uuid",
          "Required": true,
          "Keys": [
            "PK"
          ],
          "Description": "Identifies the approval request.",
          "Extra": "Default gen_random_uuid()."
        },
        {
          "Name": "user_id",
          "Type": "uuid",
          "Required": true,
          "Keys": [
            "FK"
          ],
          "Description": "Identifies the administrator requesting access.",
          "Extra": ""
        },
        {
          "Name": "requesting_session_id",
          "Type": "uuid",
          "Required": true,
          "Keys": [
            "FK"
          ],
          "Description": "Identifies the Auth session awaiting authorization.",
          "Extra": "Part of composite UQ (requesting_session_id, session_scope); the pair must be unique, not either column individually."
        },
        {
          "Name": "approver_session_id",
          "Type": "uuid",
          "Required": false,
          "Keys": [
            "FK"
          ],
          "Description": "Records the Auth session that decided the request. Deleting that session clears this attribution without deleting the request.",
          "Extra": ""
        },
        {
          "Name": "session_scope",
          "Type": "text",
          "Required": true,
          "Keys": [],
          "Description": "Separates dashboard login from attendance-scanner login.",
          "Extra": "CHECK dashboard or attendance. Part of composite UQ (requesting_session_id, session_scope); the pair must be unique, not either column individually."
        },
        {
          "Name": "device_label",
          "Type": "text",
          "Required": true,
          "Keys": [],
          "Description": "Describes the requesting browser for the approval notification. The request function limits the label to 180 characters; text has no declared character length.",
          "Extra": ""
        },
        {
          "Name": "status",
          "Type": "text",
          "Required": true,
          "Keys": [],
          "Description": "Records the decision state. Expiration is calculated from timestamps and is not an additional stored status.",
          "Extra": "Default pending. CHECK pending, approved, denied, or cancelled."
        },
        {
          "Name": "requested_at",
          "Type": "timestamptz",
          "Required": true,
          "Keys": [],
          "Description": "Records creation of the request.",
          "Extra": "Default now()."
        },
        {
          "Name": "expires_at",
          "Type": "timestamptz",
          "Required": true,
          "Keys": [],
          "Description": "Limits how long the pending request may be decided.",
          "Extra": "Default now() + interval 2 minutes."
        },
        {
          "Name": "decided_at",
          "Type": "timestamptz",
          "Required": false,
          "Keys": [],
          "Description": "Records when approval or denial was recorded.",
          "Extra": ""
        },
        {
          "Name": "approval_expires_at",
          "Type": "timestamptz",
          "Required": false,
          "Keys": [],
          "Description": "Retains the approval-validity boundary. A valid approval does not replace the current trusted-device and authorized-session checks.",
          "Extra": ""
        },
        {
          "Name": "trusted_device_id",
          "Type": "uuid",
          "Required": false,
          "Keys": [],
          "Description": "Snapshots the trusted device being replaced. Deliberately not a foreign key: historical requests must survive replacement of the trusted row.",
          "Extra": ""
        }
      ]
    },
    {
      "Name": "private.admin_trusted_devices",
      "Purpose": "Stores one current trusted browser public key per administrator account. Browser trust is fixed at thirty days and is separate from normal account logout and phone-camera pairing.",
