erDiagram
    %% Documentation ERD based on the current Supabase public schema.
    %% AUTH_USERS is Supabase-managed auth.users; it is not a public application table.
    %% MEMBERS.auth_user_id uniqueness was confirmed from the live pg_indexes catalog.

    AUTH_USERS {
        uuid id PK
        text email
    }

    PROFILES {
        uuid id PK,FK
        text username UK
        text full_name
        text role
        text account_status
        text email
    }

    MEMBERSHIP_APPLICATIONS {
        uuid id PK
        uuid auth_user_id FK
        uuid member_id FK
        uuid reviewed_by FK
        text application_type
        text full_name
        text plan
        numeric plan_price
        text status
        timestamptz submitted_at
        timestamptz reviewed_at
    }

    MEMBERS {
        uuid id PK
        uuid auth_user_id FK,UK
        uuid application_id FK,UK
        text full_name
        text email
        text username
        text mobile
        date date_of_birth
        smallint age
        numeric height
        numeric weight_kg
        jsonb emergency_contact
        text plan
        numeric plan_price
        numeric paid
        date start_date
        date end_date
        date expiry_date
        text status
    }

    ATTENDANCE {
        uuid id PK
        uuid member_id FK
        uuid recorded_by FK
        date date
        timestamptz time_in
        timestamptz time_out
    }

    PRODUCTS {
        uuid id PK
        text name
        text category
        numeric price_per_unit
        text unit
        integer stock
        boolean is_active
        timestamptz archived_at
    }

    SALES {
        uuid id PK
        uuid member_id FK
        uuid processed_by FK
        text receipt_number UK
        text customer_type
        text customer_name
        numeric total
        text status
        timestamptz sold_at
    }

    SALE_ITEMS {
        uuid id PK
        uuid sale_id FK
        uuid product_id FK
        text item_name
        text category
        numeric quantity
        text unit
        numeric unit_price
        numeric line_total
    }

    MEMBERSHIP_HISTORY {
        uuid id PK
        uuid member_id FK
        uuid recorded_by FK
        text event_type
        text previous_plan
        text new_plan
        numeric previous_price
        numeric new_price
        date previous_expiry_date
        date new_expiry_date
        timestamptz recorded_at
    }

    AUTH_USERS ||--o| PROFILES : "profile id"
    AUTH_USERS o|--o| MEMBERS : "auth_user_id (unique)"
    AUTH_USERS o|--o{ MEMBERSHIP_APPLICATIONS : "auth_user_id"
    PROFILES o|--o{ MEMBERSHIP_APPLICATIONS : "reviewed_by"
    MEMBERS o|--o{ MEMBERSHIP_APPLICATIONS : "member_id"
    MEMBERSHIP_APPLICATIONS o|--o| MEMBERS : "application_id (unique)"
    MEMBERS ||--o{ ATTENDANCE : "member_id"
    AUTH_USERS o|--o{ ATTENDANCE : "recorded_by"
    MEMBERS o|--o{ SALES : "member_id"
    AUTH_USERS o|--o{ SALES : "processed_by"
    SALES ||--o{ SALE_ITEMS : "sale_id"
    PRODUCTS o|--o{ SALE_ITEMS : "product_id"
    MEMBERS ||--o{ MEMBERSHIP_HISTORY : "member_id"
    AUTH_USERS o|--o{ MEMBERSHIP_HISTORY : "recorded_by"
