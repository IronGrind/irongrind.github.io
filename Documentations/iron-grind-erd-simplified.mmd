erDiagram
    %% Simplified documentation view: key fields and confirmed core relationships.
    %% Compatibility columns and non-relational detail fields are omitted for readability.
    %% Supabase Auth is shown as AUTH_USERS; it is managed outside the public schema.

    AUTH_USERS {
        uuid id PK
        text email
    }

    PROFILES {
        uuid id PK,FK
        text username UK
        text full_name
        text role
        text account_status
    }

    MEMBERSHIP_APPLICATIONS {
        uuid id PK
        uuid auth_user_id FK
        uuid member_id FK
        uuid reviewed_by FK
        text application_type
        text plan
        text status
        timestamptz submitted_at
    }

    MEMBERS {
        uuid id PK
        uuid auth_user_id FK
        uuid application_id FK,UK
        text full_name
        text email
        text plan
        date start_date
        date expiry_date
        text status
    }

    ATTENDANCE {
        uuid id PK
        uuid member_id FK
        uuid recorded_by FK
        timestamptz time_in
        timestamptz time_out
    }

    PRODUCTS {
        uuid id PK
        text name
        text category
        numeric price_per_unit
        integer stock
        boolean is_active
    }

    SALES {
        uuid id PK
        uuid member_id FK
        uuid processed_by FK
        text receipt_number UK
        numeric total
        text status
        timestamptz sold_at
    }

    SALE_ITEMS {
        uuid id PK
        uuid sale_id FK
        uuid product_id FK
        text item_name
        numeric quantity
        numeric unit_price
        numeric line_total
    }

    MEMBERSHIP_HISTORY {
        uuid id PK
        uuid member_id FK
        uuid recorded_by FK
        text event_type
        text previous_plan
        text new_plan
        date previous_expiry_date
        date new_expiry_date
        timestamptz recorded_at
    }

    AUTH_USERS ||--o| PROFILES : "profile id"
    AUTH_USERS o|--o| MEMBERS : "auth_user_id (unique)"
    AUTH_USERS o|--o{ MEMBERSHIP_APPLICATIONS : "auth_user_id"
    AUTH_USERS o|--o{ ATTENDANCE : "recorded_by"
    AUTH_USERS o|--o{ SALES : "processed_by"
    AUTH_USERS o|--o{ MEMBERSHIP_HISTORY : "recorded_by"

    PROFILES o|--o{ MEMBERSHIP_APPLICATIONS : "reviewed_by"
    MEMBERS o|--o{ MEMBERSHIP_APPLICATIONS : "member_id"
    MEMBERSHIP_APPLICATIONS o|--o| MEMBERS : "application_id"
    MEMBERS ||--o{ ATTENDANCE : "member_id"
    MEMBERS o|--o{ SALES : "member_id"
    MEMBERS ||--o{ MEMBERSHIP_HISTORY : "member_id"
    SALES ||--o{ SALE_ITEMS : "sale_id"
    PRODUCTS o|--o{ SALE_ITEMS : "product_id"
