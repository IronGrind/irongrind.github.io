erDiagram
    direction TB
    %% Simplified view of the project database: core fields and declared foreign keys.
    %% AUTH_USERS represents Supabase auth.users, which is managed outside public.
    %% Nullable foreign keys and uniqueness are shown where they affect relationships.

    AUTH_USERS {
        uuid id PK
        text email
    }

    PROFILES {
        uuid id PK,FK
        text username UK
        text full_name
        text role
    }

    MEMBERS {
        uuid id PK
        uuid auth_user_id FK,UK
        uuid application_id FK
        text full_name
        text email
        text plan
        numeric plan_price
        date start_date
        date expiry_date
        text status
    }

    MEMBERSHIP_APPLICATIONS {
        uuid id PK
        uuid auth_user_id FK
        uuid member_id FK
        uuid reviewed_by FK
        text application_type
        text full_name
        text plan
        numeric plan_price
        text status
        timestamptz submitted_at
        timestamptz reviewed_at
    }

    ATTENDANCE {
        uuid id PK
        uuid member_id FK
        uuid recorded_by FK
        timestamptz time_in
        timestamptz time_out
    }

    PRODUCTS {
        uuid id PK
        text name
        text category
        numeric price_per_unit
        text unit
        integer stock
        boolean is_active
    }

    SALES {
        uuid id PK
        uuid member_id FK
        uuid processed_by FK
        text receipt_number UK
        text customer_type
        text customer_name
        numeric total
        text status
        timestamptz sold_at
    }

    SALE_ITEMS {
        uuid id PK
        uuid sale_id FK
        uuid product_id FK
        text item_name
        text category
        numeric quantity
        text unit
        numeric unit_price
        numeric line_total
    }

    MEMBERSHIP_HISTORY {
        uuid id PK
        uuid member_id FK
        uuid recorded_by FK
        text event_type
        text previous_plan
        text new_plan
        date previous_expiry_date
        date new_expiry_date
        timestamptz recorded_at
    }

    AUTH_USERS ||--o| PROFILES : "profile"
    AUTH_USERS o|--o| MEMBERS : "member login"
    AUTH_USERS ||--o{ MEMBERSHIP_APPLICATIONS : "applicant"
    AUTH_USERS o|--o{ MEMBERSHIP_APPLICATIONS : "reviewer"
    AUTH_USERS o|--o{ ATTENDANCE : "recorder"
    AUTH_USERS o|--o{ SALES : "processor"
    AUTH_USERS o|--o{ MEMBERSHIP_HISTORY : "recorder"

    MEMBERS o|--o{ MEMBERSHIP_APPLICATIONS : "renewal request"
    MEMBERSHIP_APPLICATIONS o|--o{ MEMBERS : "registration source"
    MEMBERS ||--o{ ATTENDANCE : "visits"
    MEMBERS o|--o{ SALES : "member sales"
    MEMBERS ||--o{ MEMBERSHIP_HISTORY : "history"
    SALES ||--o{ SALE_ITEMS : "line items"
    PRODUCTS o|--o{ SALE_ITEMS : "sold product"
