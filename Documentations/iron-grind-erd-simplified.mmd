erDiagram
    direction TB
    %% Simplified view of the project database: core fields and declared foreign keys.
    %% AUTH_USERS represents Supabase auth.users, which is managed outside public.
    %% Nullable foreign keys and uniqueness are shown where they affect relationships.

    AUTH_USERS {
        uuid id PK
        text email
    }

    PROFILES {
        uuid id PK,FK
        varchar(30) username UK
        varchar(150) full_name
        varchar(20) role
        varchar(254) email
    }

    MEMBERS {
        uuid id PK
        uuid auth_user_id FK,UK
        uuid application_id FK,UK
        varchar(150) full_name
        varchar(254) email
        varchar(11) mobile
        varchar(30) plan
        numeric plan_price
        date start_date
        date expiry_date
        varchar(20) status
        varchar(40) registration_source
    }

    MEMBERSHIP_APPLICATIONS {
        uuid id PK
        uuid auth_user_id FK
        uuid member_id FK
        uuid reviewed_by FK
        varchar(20) application_type
        varchar(150) full_name
        varchar(254) email
        varchar(30) username
        varchar(11) mobile
        varchar(30) plan
        numeric plan_price
        varchar(20) status
        timestamptz submitted_at
        timestamptz reviewed_at
    }

    ATTENDANCE {
        uuid id PK
        uuid member_id FK
        uuid recorded_by FK
        timestamptz time_in
        timestamptz time_out
    }

    PRODUCTS {
        uuid id PK
        varchar(120) name
        varchar(20) category
        varchar(30) size
        numeric price_per_unit
        varchar(12) unit
        integer stock
        boolean is_active
    }

    SALES {
        uuid id PK
        uuid member_id FK
        uuid processed_by FK
        varchar(64) receipt_number UK
        varchar(15) customer_type
        varchar(150) customer_name
        numeric total
        varchar(12) status
        timestamptz sold_at
    }

    SALE_ITEMS {
        uuid id PK
        uuid sale_id FK
        uuid product_id FK
        varchar(150) item_name
        varchar(20) category
        numeric quantity
        varchar(12) unit
        numeric unit_price
        numeric line_total
    }

    MEMBERSHIP_HISTORY {
        uuid id PK
        uuid member_id FK
        uuid recorded_by FK
        varchar(30) event_type
        varchar(30) previous_plan
        varchar(30) new_plan
        date previous_expiry_date
        date new_expiry_date
        timestamptz recorded_at
    }

    AUTH_USERS ||--o| PROFILES : "profile"
    AUTH_USERS o|--o| MEMBERS : "member login"
    AUTH_USERS ||--o{ MEMBERSHIP_APPLICATIONS : "applicant"
    AUTH_USERS o|--o{ ATTENDANCE : "recorder"
    AUTH_USERS o|--o{ SALES : "processor"
    AUTH_USERS o|--o{ MEMBERSHIP_HISTORY : "recorder"

    PROFILES o|--o{ MEMBERSHIP_APPLICATIONS : "reviewer"
    MEMBERS o|--o{ MEMBERSHIP_APPLICATIONS : "renewal request"
    MEMBERSHIP_APPLICATIONS o|--o| MEMBERS : "registration source"
    MEMBERS ||--o{ ATTENDANCE : "visits"
    MEMBERS o|--o{ SALES : "member sales"
    MEMBERS ||--o{ MEMBERSHIP_HISTORY : "history"
    SALES ||--o{ SALE_ITEMS : "line items"
    PRODUCTS o|--o{ SALE_ITEMS : "sold product"
